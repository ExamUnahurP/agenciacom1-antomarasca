import agenciaDeViajes.*

describe "Test de la agencia" {

    test "Valor fianl de un pack" {
        const viaje1 = new Nacional(precioBase = 300)

        const viaje2 = new Nacional (precioBase = 300)
        trasladosPrivados.precio(100)
        accesoASalasVIP.precio(150)

        const viaje3 = new Internacional(precioBase = 300)
        

        viaje2.agregarBeneficio(trasladosPrivados)
        viaje2.agregarBeneficio(accesoASalasVIP)

        assert.equals(300, viaje1.valorFinal())
        assert.equals(550, viaje2.valorFinal())
        assert.equals(360, viaje3.valorFinal())
    }

    test "Determina si el cordi esta calificado" {
        const cordi1 = new Coordinador (estaMotivado= true, aniosDeExperiencia=3, viajes=21)
        cordi1.cambiarDeRol(Guia)

        const cordi2 = new Coordinador (estaMotivado= true, aniosDeExperiencia=2)
        cordi2.cambiarDeRol(AsistenteLogistico)

        const cordi3 = new Coordinador (estaMotivado= true, aniosDeExperiencia=4, viajes=25)
        cordi3.cambiarDeRol(Acompaniante)

        assert.that(cordi1.altamenteCalificado())
        assert.notThat(cordi2.altamenteCalificado())
        assert.that(cordi3.altamenteCalificado())
    }

}